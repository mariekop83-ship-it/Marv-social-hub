<div class="row"><div><div class="eyebrow">Account</div><h1>Your profile</h1></div></div>
<div class="cards">
  <div class="card"><h2>Details</h2>
    <div class="field"><label>Full name</label><input readonly value="<%= account.name %>"></div>
    <div class="field"><label>Username</label><input readonly value="<%= account.username %>"></div>
    <div class="field"><label>Email</label><input readonly value="<%= account.email %>"></div>
    <div class="field"><label>Joined</label><input readonly value="<%= account.created_at %>"></div>
  </div>
  <div class="card"><h2>Change password</h2>
    <form method="post" action="/profile/password"><input type="hidden" name="csrf" value="<%= csrf %>">
      <div class="field"><label>Current password</label><input type="password" name="current" autocomplete="current-password" required></div>
      <div class="field"><label>New password (at least 10 characters)</label><input type="password" name="password" minlength="10" autocomplete="new-password" required></div>
      <div class="field"><label>Repeat new password</label><input type="password" name="confirm" minlength="10" autocomplete="new-password" required></div>
      <button class="btn" type="submit">Change password</button>
    </form>
  </div>
</div>
