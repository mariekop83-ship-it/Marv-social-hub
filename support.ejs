<div class="row"><div><div class="eyebrow">Help centre</div><h1>Support</h1><p class="muted">Send a message to the Mar Social Hub team.</p></div><%if(supportUrl){%><a class="btn secondary" href="<%=supportUrl%>" target="_blank" rel="noopener">Open support link</a><%}%></div><div class="cards"><div class="card"><h2>Send a message</h2><form method="post" action="/support"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="field"><label>Message</label><textarea name="message" required maxlength="3000"></textarea></div><button class="btn">Send message</button></form></div><div class="card"><h2>Conversation</h2><%if(!messages.length){%><p class="muted">No messages yet.</p><%}else{%><div class="stack"><%messages.forEach(m=>{%><div class="notice"><strong><%=m.sender_role==='admin'?'Mar Social Hub Support':'You'%></strong><br><%=m.message%><br><small><%=m.created_at%></small></div><%})%></div><%}%></div></div>
