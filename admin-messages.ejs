<div class="row"><div><div class="eyebrow">Administrator</div><h1>Support inbox</h1></div><a class="btn secondary" href="/admin">Back to admin</a></div><div class="stack"><%if(!messages.length){%><div class="card empty">No support messages.</div><%}else{messages.forEach(m=>{%><div class="card"><div class="row"><strong><%=m.name%> · <%=m.email%></strong><small class="muted"><%=m.created_at%></small></div><p style="white-space:pre-wrap"><%=m.message%></p><form method="post" action="/admin/messages/<%=m.id%>/reply"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="field"><label>Reply to customer</label><textarea name="message" maxlength="3000" required></textarea></div><button class="btn">Send reply</button></form></div><%})}%></div>
