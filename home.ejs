<section class="hero" style="padding:8px 0 22px">
  <div class="eyebrow">Your digital services hub</div>
  <h1>Numbers, SMM boosting and social logs in one place.</h1>
  <p class="muted">Pick a service from the menu or from the cards below.</p>
  <% if(!user){ %><div class="inline-form" style="margin-top:14px"><a class="btn" href="/register">Create account</a><a class="btn secondary" href="/login">Sign in</a></div><% } %>
</section>
<div class="product-grid">
<% Object.keys(features).forEach(function(sl){ var f=features[sl]; %>
  <a class="product-card" href="/service/<%= sl %>">
    <div class="product-body">
      <div class="service-icon"><%= f.icon %></div>
      <h3><%= f.title %></h3>
      <p class="muted"><%= f.type==='numbers'?'Virtual numbers for verification.':(f.type==='smm'?'Social media growth services.':'Ready-made social accounts.') %></p>
    </div>
  </a>
<% }) %>
</div>
