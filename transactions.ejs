<div class="row"><div><div class="eyebrow">Wallet</div><h1>Transactions</h1></div><a class="btn" href="/fund">Fund wallet</a></div><div class="card"><%if(!transactions.length){%><div class="empty">No wallet transactions yet.</div><%}else{%><div class="table-wrap"><table><tr><th>Date</th><th>Type</th><th>Amount</th><th>Balance after</th><th>Reference</th><th>Description</th></tr><%transactions.forEach(t=>{%><tr><td><%=t.created_at%></td><td><%=t.kind%></td><td><%=money(t.amount)%></td><td><%=money(t.balance_after)%></td><td><%=t.reference%></td><td><%=t.description%></td></tr><%})%></table></div><%}%></div>
