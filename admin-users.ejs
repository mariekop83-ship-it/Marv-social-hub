<div class="row"><div><div class="eyebrow">Administrator</div><h1>Manage users</h1></div><a class="btn secondary" href="/admin">Back to admin</a></div><div class="card"><div class="table-wrap"><table><tr><th>User</th><th>Wallet balance</th><th>Role</th><th>Status</th><th>Joined</th><th>Control</th></tr><%users.forEach(u=>{%><tr><td><strong><%=u.name%></strong><br><small><%=u.username%> · <%=u.email%></small></td><td><%=money(u.balance)%></td><td><%=u.role%></td><td><span class="pill"><%=u.status%></span></td><td><%=u.created_at%></td><td><form method="post" action="/admin/users/<%=u.id%>/status"><input type="hidden" name="csrf" value="<%=csrf%>"><select name="status"><option value="active" <%=u.status==='active'?'selected':''%>>Active</option><option value="blocked" <%=u.status==='blocked'?'selected':''%>>Blocked</option></select><button class="btn small">Save</button></form></td></tr><%})%></table></div></div>
