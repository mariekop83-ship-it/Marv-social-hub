<div class="row"><div><div class="eyebrow">Administrator</div><h1>Customers and wallets</h1><p class="muted">Add or remove wallet money, or block an account. Every change is recorded in the customer's transactions.</p></div><a class="btn secondary" href="/admin">Back to admin</a></div>
<div class="stack">
<% users.forEach(function(u){ %>
  <div class="card">
    <div class="row" style="margin-bottom:10px"><div><strong><%= u.name %></strong><br><small class="muted">@<%= u.username %> · <%= u.email %> · <%= u.role %> · joined <%= u.created_at %></small></div><div><span class="pill"><%= u.status %></span> <strong class="price"><%= money(u.balance) %></strong></div></div>
    <form class="inline-form" method="post" action="/admin/users/<%= u.id %>/wallet">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <select name="direction"><option value="credit">Add money</option><option value="debit">Remove money</option></select>
      <input type="number" name="amount" min="0.01" step="0.01" placeholder="Amount (NGN)" required>
      <input name="note" maxlength="150" placeholder="Note (optional)">
      <button class="btn small" type="submit" data-confirm="Change this customer's wallet?">Update wallet</button>
    </form>
    <form class="inline-form" style="margin-top:8px" method="post" action="/admin/users/<%= u.id %>/status">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <select name="status"><option value="active" <%= u.status==='active'?'selected':'' %>>Active</option><option value="blocked" <%= u.status==='blocked'?'selected':'' %>>Blocked</option></select>
      <button class="btn small secondary" type="submit">Save status</button>
    </form>
  </div>
<% }) %>
</div>
