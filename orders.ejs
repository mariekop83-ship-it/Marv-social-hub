<div class="row"><div><div class="eyebrow">Customer area</div><h1>My orders</h1><p class="muted">Your recent and historical service orders.</p></div><a class="btn" href="/services">Browse services</a></div><div class="card"><%if(!orders.length){%><div class="empty">You have no orders yet.</div><%}else{%><div class="table-wrap"><table><tr><th>Order</th><th>Service</th><th>Provider</th><th>Amount</th><th>Status</th><th>Created</th><th>Details</th></tr><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.service_name%></td><td><%=o.provider_key%></td><td><%=money(o.amount)%></td><td><span class="pill"><%=o.status%></span></td><td><%=o.created_at%></td><td><%=o.phone_number||o.otp_code||o.details||'—'%></td></tr><%})%></table></div><%}%></div>
