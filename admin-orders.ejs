<div class="row"><div><div class="eyebrow">Administrator</div><h1>All orders</h1></div><a class="btn secondary" href="/admin">Back to admin</a></div><div class="card"><div class="table-wrap"><table><tr><th>Order</th><th>Customer</th><th>Service</th><th>Provider</th><th>Amount</th><th>Status</th><th>Created</th></tr><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.name%><br><small><%=o.email%></small></td><td><%=o.service_name%></td><td><%=o.provider_key%></td><td><%=money(o.amount)%></td><td><span class="pill"><%=o.status%></span></td><td><%=o.created_at%></td></tr><%})%></table></div></div>
