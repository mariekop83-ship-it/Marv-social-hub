<div class="row">
  <div>
    <div class="eyebrow"><%= feature ? 'Service' : 'Service catalogue' %></div>
    <h1><%= feature ? feature.title : ({numbers:'Numbers',smm:'SMM Boosting',logs:'Social Logs'})[type] %></h1>
    <p class="muted">Prices are in naira. Services appear here after an administrator syncs the provider catalogue.</p>
  </div>
  <% if(user && feature){ %><a class="btn secondary" href="/history/<%= slug %>">History</a><% } else if(user){ %><a class="btn secondary" href="/orders">My orders</a><% } %>
</div>

<% if(!services.length){ %>
  <div class="card"><div class="empty"><h2>No services yet</h2><p>An administrator needs to add the provider key and run the catalogue sync in Admin, Website settings.</p></div></div>
<% } else { %>
  <div class="card">
    <div class="product-grid">
      <% services.forEach(function(s){ %>
        <div class="product-card">
          <div class="product-body">
            <span class="pill"><%= s.category || 'General' %></span>
            <h3><%= s.name %></h3>
            <p class="muted">Quantity <%= s.min_quantity %> to <%= s.max_quantity %></p>
            <div class="product-foot"><strong class="price"><%= Number(s.display_price)>0 ? money(s.display_price) : 'Price not set' %></strong></div>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="muted catalogue-note">Ordering is not switched on in this version yet. Browsing is available now.</p>
  </div>
<% } %>
