<div class="row"><div><div class="eyebrow">Administrator</div><h1>Service pricing</h1><p class="muted">Set the customer price in NGN. Provider cost is shown for administrator review only.</p></div><a class="btn secondary" href="/admin">Back to admin</a></div><div class="inline-form" style="margin:14px 0"><%['numbers','smm','logs'].forEach(t=>{%><a class="btn <%=type===t?'':'secondary'%>" href="/admin/services?type=<%=t%>"><%=t==='numbers'?'Numbers':t==='smm'?'SMM Boosting':'Social Logs'%></a><%})%></div><div class="card"><%if(!services.length){%><div class="empty">No services in this category. Sync the relevant provider catalogue in Website Settings.</div><%}else{%><div class="table-wrap"><table><tr><th>Service / provider ID</th><th>Provider</th><th>Cost</th><th>Customer NGN price</th><th>Visibility</th><th>Save</th></tr><%services.forEach(s=>{%><tr><td><strong><%=s.name%></strong><br><small class="muted"><%=s.category%> · <%=s.provider_service_id%></small></td><td><%=s.provider_key%></td><td><%=s.provider_cost===null?'—':`${s.provider_cost} ${s.provider_currency||''}`%></td><td colspan="3"><form class="inline-form" method="post" action="/admin/services/<%=s.id%>/price"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="type" value="<%=type%>"><input type="number" name="price" min="0" max="1000000000" step="0.01" value="<%=s.price%>" aria-label="Customer NGN price"><select name="enabled" aria-label="Service visibility"><option value="1" <%=s.enabled?'selected':''%>>Enabled</option><option value="0" <%=!s.enabled?'selected':''%>>Disabled</option></select><button class="btn small">Save price</button></form></td></tr><%})%></table></div><%}%></div>
