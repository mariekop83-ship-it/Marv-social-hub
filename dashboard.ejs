<div class="row"><div><div class="eyebrow">Customer area</div><h1>Welcome, <%= account.name %></h1><p class="muted">Your account overview and recent activity.</p></div><a class="btn" href="/services?type=smm">Browse services</a></div><div class="cards"><div class="card"><div class="muted">Available wallet balance</div><div class="stat"><%= money(account.balance) %></div><a href="/fund">Fund wallet →</a></div><div class="card"><div class="muted">Account username</div><div class="stat" style="font-size:21px">@<%= account.username %></div><a href="/profile">View profile →</a></div><div class="card"><div class="muted">Need assistance?</div><h2>We're here to help</h2><a href="/support">Contact support →</a></div></div><div class="card" style="margin-top:18px"><h2>Recent orders</h2><% if(!orders.length){%><div class="empty">No orders yet. <a href="/services">Browse services</a>.</div><%}else{%><div class="table-wrap"><table><tr><th>Order</th><th>Service</th><th>Amount</th><th>Status</th><th>Date</th></tr><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.service_name%></td><td><%=money(o.amount)%></td><td><span class="pill"><%=o.status%></span></td><td><%=o.created_at%></td></tr><%})%></table></div><%}%></div><div class="card" style="margin-top:18px"><h2>Recent wallet activity</h2><%if(!transactions.length){%><p class="muted">No wallet transactions yet.</p><%}else{%><div class="table-wrap"><table><tr><th>Type</th><th>Amount</th><th>Description</th><th>Date</th></tr><%transactions.forEach(t=>{%><tr><td><%=t.kind%></td><td><%=money(t.amount)%></td><td><%=t.description%></td><td><%=t.created_at%></td></tr><%})%></table></div><%}%></div>
