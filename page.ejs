<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080d19">
<title><%= title %> · Mar Social Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<link rel="stylesheet" href="/assets/msh-extra.css">
</head>
<body>
<div class="loader" role="status" aria-live="polite" aria-hidden="false">
  <div class="loader-content">
    <div class="mar-loader-mark"><span>M</span><span>A</span><span>R</span><i>.</i></div>
    <div class="loader-brand">SOCIAL HUB</div>
    <div class="loader-caption">Loading…</div>
    <div class="loader-track"><span></span></div>
  </div>
</div>
<script>setTimeout(function(){var l=document.querySelector('.loader');if(l)l.classList.add('hidden');},6000);</script>

<div class="app">
  <div class="mobile-shade"></div>
  <aside class="sidebar" id="menu">
    <a class="brand" href="/"><span class="brand-mark">M</span><span>MAR Social Hub</span></a>
    <nav class="nav">
      <div class="nav-label">MAIN</div>
      <a class="<%= path==='/'?'active':'' %>" href="/">Home</a>
      <% if(user){ %><a class="<%= path==='/dashboard'?'active':'' %>" href="/dashboard">Dashboard</a><% } %>

      <% [['NUMBERS',['buy-number-1','buy-number-2']],['SMM BOOSTING',['smm-boost-1','smm-boost-2']],['SOCIAL LOGS',['social-log-1','social-log-2']]].forEach(function(g){ %>
        <div class="nav-label"><%= g[0] %></div>
        <% g[1].forEach(function(sl){ var f=features[sl]; %>
          <a class="<%= path==='/service/'+sl?'active':'' %>" href="/service/<%= sl %>"><span><%= f.icon %></span> <%= f.title %></a>
          <a class="sub <%= path==='/history/'+sl?'active':'' %>" href="/history/<%= sl %>">History</a>
        <% }) %>
      <% }) %>

      <% if(user){ %>
        <div class="nav-label">WALLET</div>
        <a class="<%= path==='/fund'?'active':'' %>" href="/fund">Fund wallet</a>
        <a class="<%= path==='/transactions'?'active':'' %>" href="/transactions">Transactions</a>
        <div class="nav-label">ACCOUNT</div>
        <a class="<%= path==='/profile'?'active':'' %>" href="/profile">Profile</a>
        <a class="<%= path==='/support'?'active':'' %>" href="/support">Support</a>
        <a class="<%= path==='/alerts'?'active':'' %>" href="/alerts">Announcements</a>
        <% if(user.role==='admin'){ %>
          <div class="nav-label">ADMIN</div>
          <% [['/admin','Admin home'],['/admin/deposits','Payment approvals'],['/admin/users','Customers and wallets'],['/admin/services','Service prices'],['/admin/orders','All orders'],['/admin/messages','Support inbox'],['/admin/channels','Payments and contact'],['/admin/settings','Website settings'],['/admin/audit','Audit log']].forEach(function(a){ %>
            <a class="<%= path===a[0]?'active':'' %>" href="<%= a[0] %>"><%= a[1] %></a>
          <% }) %>
        <% } %>
        <form method="post" action="/logout" class="nav-logout">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button type="submit" class="btn secondary">Sign out</button>
        </form>
      <% } else { %>
        <div class="nav-label">ACCOUNT</div>
        <a class="<%= path==='/login'?'active':'' %>" href="/login">Sign in</a>
        <a class="<%= path==='/register'?'active':'' %>" href="/register">Create account</a>
      <% } %>
    </nav>
  </aside>

  <main class="main">
    <div class="topbar">
      <div class="top-left">
        <button class="hamb" type="button" aria-label="Open menu" aria-controls="menu" aria-expanded="false">&#9776;</button>
        <div class="page-title"><%= title %></div>
      </div>
    </div>
    <% if(flash){ %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
    <%- include(body) %>
    <p class="site-foot">© <%= new Date().getFullYear() %> Mar Social Hub</p>
  </main>
</div>

<% if(user){ %><a class="support-float" href="/support" aria-label="Contact support">?</a><% } %>
<script src="/assets/app.js"></script>
</body>
</html>
