<div class="row"><div><div class="eyebrow">Wallet</div><h1>Fund wallet</h1><p class="muted">Submit a transfer reference for admin review.</p></div></div><div class="cards"><div class="card"><h2>Payment instructions</h2><p style="white-space:pre-wrap"><%=paymentDetails%></p><p class="muted">Only submit a request after making the transfer. Your balance is not credited until the admin verifies and approves it.</p></div><div class="card"><h2>Submit payment</h2><form method="post" action="/fund"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="field"><label>Amount (NGN)</label><input type="number" name="amount" min="100" max="100000000" step="0.01" required></div><div class="field"><label>Name used for transfer</label><input name="sender_name" maxlength="160"></div><div class="field"><label>Bank/payment reference</label><input name="payment_reference" maxlength="160"></div><div class="field"><label>Note</label><textarea name="note" maxlength="1000"></textarea></div><button class="btn">Submit for review</button></form></div></div><div class="card" style="margin-top:18px"><h2>My deposit requests</h2><%if(!deposits.length){%><p class="muted">No deposit requests yet.</p><%}else{%><div class="table-wrap"><table><tr><th>Reference</th><th>Amount</th><th>Status</th><th>Created</th></tr><%deposits.forEach(d=>{%><tr><td><%=d.reference%></td><td><%=money(d.amount)%></td><td><span class="pill"><%=d.status%></span></td><td><%=d.created_at%></td></tr><%})%></table></div><%}%></div>
